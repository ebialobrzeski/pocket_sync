# Copy to .env next to docker-compose.yml and `chmod 600 .env`. Never commit .env.

# --- required -----------------------------------------------------------------------------
POCKET_API_KEY=

# Host paths (used by docker-compose.yml for the bind mounts); may be on the same or different volumes
# Data: metadata, state DB and logs (mounted at /data)
POCKET_DATA_PATH=/volume1/docker/pocket-sync
# Audio files (mounted at /audio)
POCKET_AUDIO_PATH=/volume2/pocket-audio

# Owner of these directories on the NAS (`id <user>` over SSH)
PUID=1000
PGID=1000

# Web UI master password (at least 8 characters)
WEB_PASSWORD=

# --- optional (defaults shown) -------------------------------------------------------------
TZ=Europe/Warsaw
# POCKET_API_BASE=https://public.heypocketai.com/api/v1
# DOWNLOAD_AUDIO=true
# SYNC_INTERVAL_MINUTES=15
# RUN_ONCE=false
# MAX_CONCURRENCY=3
# FULL_REFRESH_HOURS=24
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_TO_FILE=false

# Web UI
# WEB_PORT=8080
# WEB_SESSION_HOURS=168
# WEB_COOKIE_SECURE=false        # true when served over HTTPS (reverse proxy)
# WEB_SECRET_KEY=                # signs session cookies; derived from WEB_PASSWORD if unset
# WEB_PASSWORD_FILE=/run/secrets/web_password   # instead of WEB_PASSWORD
# SYNC_PAUSED=false              # usually toggled from the web UI instead

# Paths inside the container; change only if you also change the mounts.
# META_DIR=/data/meta/pocket
# STATE_DIR=/data/state
# AUDIO_DIR=/audio
